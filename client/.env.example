# Copy to .env.local for local development.
# For deployment, set this in your hosting provider env vars.

# Leave empty to use the Vite dev proxy (see client/vite.config.ts) to http://localhost:3000.
# Set to your deployed backend API origin when building for production, e.g. https://api.example.com
# IMPORTANT: In production this must be non-empty, because frontend/backend are deployed separately.
VITE_API_BASE_URL=
