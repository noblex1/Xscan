{
  "name": "catchers-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "build:dev": "npm run build:dev --prefix client",
    "lint": "npm run lint --prefix client",
    "preview": "npm run preview --prefix client",
    "dev:backend": "npm run dev --prefix backend",
    "dev:client": "npm run dev --prefix client",
    "dev:ml": "cd ml-service && python -m uvicorn app.main:app --host 127.0.0.1 --port 5000 --reload",
    "dev:stack": "concurrently -n ml,api,web -c cyan,magenta,green \"npm run dev:ml\" \"npm run dev:backend\" \"npm run dev:client\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d client/dist"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
