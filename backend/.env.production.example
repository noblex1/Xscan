# Production backend environment variables
# Set these in your backend host (Render/Railway/Fly/etc)

NODE_ENV=production
PORT=3000

# MongoDB (Atlas recommended)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/catchers-ai

# Comma-separated list of allowed frontend origins (no wildcard)
CORS_ORIGIN=https://your-frontend.example.com

# Deployed ML service URL
ML_SERVICE_URL=https://your-ml-service.example.com

# Optional threat intelligence API keys
# VIRUSTOTAL_API_KEY=
# GOOGLE_SAFEBROWSING_API_KEY=
# ABUSEIPDB_API_KEY=
# PHISHTANK_API_KEY=

# Optional tuning
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
