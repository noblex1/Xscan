# Copy to .env and adjust. Backend loads this via dotenv.

PORT=3000
NODE_ENV=development

# Local: start Mongo with `docker compose up -d` from the repo root, then:
MONGODB_URI=mongodb://localhost:27017/catchers-ai

# Frontend origin(s) allowed by CORS (comma-separated, no wildcards).
# In development, localhost / 127.0.0.1 / ::1 on any port are also accepted automatically.
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://[::1]:8080

# Python ML service (must be running for full AI scoring)
ML_SERVICE_URL=http://localhost:5000

# Optional threat intel (scans still work without these; some checks are skipped)
# VIRUSTOTAL_API_KEY=
# GOOGLE_SAFEBROWSING_API_KEY=
# ABUSEIPDB_API_KEY=
# PHISHTANK_API_KEY=

# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
